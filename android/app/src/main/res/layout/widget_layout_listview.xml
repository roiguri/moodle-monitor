<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable ListView widget showing up to 10 deadlines -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:layoutDirection="rtl">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:contentDescription="@string/cd_calendar_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_header_deadlines"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:fontFamily="sans-serif"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Scrollable List of Tasks -->
    <ListView
        android:id="@+id/task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:divider="@null"
        android:dividerHeight="4dp"/>

    <!-- Empty View (shown when no tasks) -->
    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/widget_empty_state"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/widget_text_secondary"
        android:fontFamily="sans-serif"
        android:visibility="gone"/>

</LinearLayout>
